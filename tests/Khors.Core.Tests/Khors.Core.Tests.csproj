<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CA1861 (массивы-литералы в аргументах) — о производительности повторных вызовов; в данных тестов не нужно. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Khors.Core\Khors.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Vectors\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
