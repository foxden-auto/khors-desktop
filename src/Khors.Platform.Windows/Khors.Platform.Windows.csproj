<Project Sdk="Microsoft.NET.Sdk">
  <!-- Реализация платформенных интерфейсов для Windows. Вся сборка помечена SupportedOSPlatform("windows"). -->
  <PropertyGroup>
    <!-- LibraryImport генерирует код маршалинга с unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Khors.Platform.Abstractions\Khors.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\Khors.Ipc\Khors.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
