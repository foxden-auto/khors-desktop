<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Фирменная палитра KHORS — как на сайте (khors-site, app/globals.css) и в KHORS Android.
    Единственное место с цветами: в разметке и коде — только эти токены (CLAUDE.md, соглашения).
  -->
  <Color x:Key="KhorsBackgroundColor">#0D1012</Color>
  <Color x:Key="KhorsForegroundColor">#F4F3ED</Color>
  <Color x:Key="KhorsCardColor">#15191B</Color>
  <Color x:Key="KhorsPrimaryColor">#E5BD70</Color>
  <Color x:Key="KhorsPrimaryForegroundColor">#16140F</Color>
  <Color x:Key="KhorsSecondaryColor">#202527</Color>
  <Color x:Key="KhorsMutedColor">#1B2022</Color>
  <Color x:Key="KhorsMutedForegroundColor">#A8ACAE</Color>
  <Color x:Key="KhorsAccentColor">#242A2C</Color>
  <Color x:Key="KhorsDestructiveColor">#FF9999</Color>
  <Color x:Key="KhorsBorderColor">#2D3335</Color>
  <Color x:Key="KhorsInputColor">#656969</Color>
  <!-- QR-код: чёрный на белом при любой теме, иначе его не прочитают камеры. -->
  <Color x:Key="KhorsQrDarkColor">#000000</Color>
  <Color x:Key="KhorsQrLightColor">#FFFFFF</Color>

  <SolidColorBrush x:Key="KhorsBackgroundBrush" Color="{StaticResource KhorsBackgroundColor}" />
  <SolidColorBrush x:Key="KhorsForegroundBrush" Color="{StaticResource KhorsForegroundColor}" />
  <SolidColorBrush x:Key="KhorsCardBrush" Color="{StaticResource KhorsCardColor}" />
  <SolidColorBrush x:Key="KhorsPrimaryBrush" Color="{StaticResource KhorsPrimaryColor}" />
  <SolidColorBrush x:Key="KhorsPrimaryForegroundBrush" Color="{StaticResource KhorsPrimaryForegroundColor}" />
  <SolidColorBrush x:Key="KhorsSecondaryBrush" Color="{StaticResource KhorsSecondaryColor}" />
  <SolidColorBrush x:Key="KhorsMutedBrush" Color="{StaticResource KhorsMutedColor}" />
  <SolidColorBrush x:Key="KhorsMutedForegroundBrush" Color="{StaticResource KhorsMutedForegroundColor}" />
  <SolidColorBrush x:Key="KhorsAccentBrush" Color="{StaticResource KhorsAccentColor}" />
  <SolidColorBrush x:Key="KhorsDestructiveBrush" Color="{StaticResource KhorsDestructiveColor}" />
  <SolidColorBrush x:Key="KhorsBorderBrush" Color="{StaticResource KhorsBorderColor}" />
  <SolidColorBrush x:Key="KhorsInputBrush" Color="{StaticResource KhorsInputColor}" />

  <!-- Задержка «хорошо»: зелёный того же уровня яркости, что и золотой. Средняя — золотой, плохая — destructive. -->
  <Color x:Key="KhorsSuccessColor">#7BC79A</Color>
  <SolidColorBrush x:Key="KhorsSuccessBrush" Color="{StaticResource KhorsSuccessColor}" />

  <!-- График скорости: два ряда разной светлоты (проверены на различимость, в том числе при дальтонизме, на фоне карточки). -->
  <Color x:Key="KhorsChartUploadColor">#4F8FD0</Color>
  <Color x:Key="KhorsChartDownloadColor">#B38D45</Color>
  <SolidColorBrush x:Key="KhorsChartUploadBrush" Color="{StaticResource KhorsChartUploadColor}" />
  <SolidColorBrush x:Key="KhorsChartDownloadBrush" Color="{StaticResource KhorsChartDownloadColor}" />

  <!-- Свечение вокруг кнопки подключения: золотой с прозрачностью; при подключении — ярче. -->
  <RadialGradientBrush x:Key="KhorsGlowIdleBrush" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="55%" RadiusY="55%">
    <GradientStop Offset="0" Color="#14E5BD70" />
    <GradientStop Offset="1" Color="#00E5BD70" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="KhorsGlowActiveBrush" Center="50%,45%" GradientOrigin="50%,45%" RadiusX="55%" RadiusY="55%">
    <GradientStop Offset="0" Color="#38E5BD70" />
    <GradientStop Offset="1" Color="#00E5BD70" />
  </RadialGradientBrush>
  <BoxShadows x:Key="KhorsOrbIdleShadow">0 0 40 0 #2EE5BD70</BoxShadows>
  <BoxShadows x:Key="KhorsOrbActiveShadow">0 0 90 12 #73E5BD70</BoxShadows>

  <!-- Акцент Fluent — фирменный золотой вместо системного цвета Windows. -->
  <Color x:Key="SystemAccentColor">#E5BD70</Color>
  <Color x:Key="SystemAccentColorDark1">#E5BD70</Color>
  <Color x:Key="SystemAccentColorDark2">#E5BD70</Color>
  <Color x:Key="SystemAccentColorDark3">#E5BD70</Color>
  <Color x:Key="SystemAccentColorLight1">#E5BD70</Color>
  <Color x:Key="SystemAccentColorLight2">#E5BD70</Color>
  <Color x:Key="SystemAccentColorLight3">#E5BD70</Color>
</ResourceDictionary>
