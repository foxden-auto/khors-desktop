<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Khors.App.ViewModels"
             xmlns:res="using:Khors.App.Resources"
             x:Class="Khors.App.Views.Pages.LogPage"
             x:DataType="vm:MainWindowViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,16">
      <TextBlock Text="{x:Static res:Strings.LogHeader}" Classes="page-title" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="secondary" IsEnabled="{Binding HasLogTail}"
              Command="{Binding CopyCoreLogCommand}" Content="{x:Static res:Strings.ButtonCopyCoreLog}" />
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Text="{x:Static res:Strings.LogMaskedNote}" Classes="caption" Margin="4,10,0,0" />
    <Border Classes="card">
      <Panel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsVisible="{Binding HasLogTail}">
          <SelectableTextBlock Text="{Binding LogTail}" Classes="log" />
        </ScrollViewer>
        <TextBlock Text="{x:Static res:Strings.LogEmpty}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" IsVisible="{Binding HasNoLogTail}" />
      </Panel>
    </Border>
  </DockPanel>
</UserControl>
