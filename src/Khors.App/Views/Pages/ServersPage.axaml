<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Khors.App.ViewModels"
             xmlns:res="using:Khors.App.Resources"
             xmlns:views="using:Khors.App.Views"
             x:Class="Khors.App.Views.Pages.ServersPage"
             x:DataType="vm:MainWindowViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,16">
      <TextBlock Text="{x:Static res:Strings.NavServers}" Classes="page-title" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="secondary" Margin="0,0,8,0" Command="{Binding TestLatencyCommand}"
              ToolTip.Tip="{x:Static res:Strings.TestLatencyTooltip}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon small" Data="{StaticResource IconRefresh}" Stroke="{DynamicResource KhorsForegroundBrush}" />
          <TextBlock Text="{x:Static res:Strings.ButtonTestLatency}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <SplitButton Grid.Column="2" Classes="secondary" Command="{Binding ImportFromClipboardCommand}" Content="{x:Static res:Strings.ButtonImportClipboard}">
        <SplitButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{x:Static res:Strings.MenuImportFile}" Command="{Binding ImportFromFileCommand}" />
            <MenuItem Header="{x:Static res:Strings.MenuImportScreen}" Command="{Binding ImportFromScreenCommand}" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
    </Grid>

    <!-- Подписки: трафик, срок, обновление. -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16" IsVisible="{Binding HasSubscriptions}" Padding="18,12">
      <Expander Header="{Binding SubscriptionsHeader}" IsExpanded="True" HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Subscriptions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" Classes="muted small" IsVisible="{Binding HasDetails}" />
                  <TextBlock Text="{Binding Status}" Classes="muted small" Classes.error="{Binding HasError}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" IsEnabled="{Binding !IsUpdating}"
                        Content="{x:Static res:Strings.ButtonUpdate}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).UpdateSubscriptionCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center"
                        Content="{x:Static res:Strings.ButtonDelete}"
                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).RemoveSubscriptionCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </Border>

    <Border Classes="card" Padding="16,14,16,12">
      <DockPanel>
        <CheckBox DockPanel.Dock="Top" Margin="4,0,0,8" IsChecked="{Binding SortByLatency}" IsVisible="{Binding HasProfiles}"
                  Content="{x:Static res:Strings.SortByLatency}" ToolTip.Tip="{x:Static res:Strings.SortByLatencyTooltip}" />
        <views:AutoRowView DockPanel.Dock="Top" Margin="0,0,0,6" />
        <Panel>
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Classes="profiles">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItemViewModel">
                <views:ProfileRowView />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{x:Static res:Strings.EmptyProfilesHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" Margin="24" IsVisible="{Binding HasNoProfiles}" />
        </Panel>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
