<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Khors.App.ViewModels"
             xmlns:res="using:Khors.App.Resources"
             x:Class="Khors.App.Views.Pages.SettingsPage"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{x:Static res:Strings.NavSettings}" Classes="page-title" Margin="4,0,0,0" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsModeHeader}" Classes="section" />
          <RadioButton GroupName="settingsMode" IsChecked="{Binding IsProxyMode}" IsEnabled="{Binding CanSelectProxy}"
                       Content="{x:Static res:Strings.ModeProxyOption}" ToolTip.Tip="{x:Static res:Strings.ModeProxyTooltip}" />
          <TextBlock Text="{x:Static res:Strings.ModeProxyTooltip}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <RadioButton GroupName="settingsMode" IsChecked="{Binding IsTunMode}" IsEnabled="{Binding CanSelectTun}"
                       Content="{x:Static res:Strings.ModeTunOption}" />
          <TextBlock Text="{x:Static res:Strings.ModeTunTooltip}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <TextBlock Text="{x:Static res:Strings.SettingsModeHint}" Classes="muted" TextWrapping="Wrap" />
          <CheckBox IsChecked="{Binding AutoReconnect}" Content="{x:Static res:Strings.SettingsAutoReconnect}" Margin="0,6,0,0" />
          <TextBlock Text="{x:Static res:Strings.SettingsAutoReconnectHint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
        </StackPanel>
      </Border>

      <!-- Kill Switch (ROADMAP 4.1): настройка хранится в службе, действует в режиме TUN. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsKillSwitchHeader}" Classes="section" />
          <TextBlock Text="{x:Static res:Strings.SettingsKillSwitchHint}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static res:Strings.KillSwitchNeedsService}" Classes="warning" TextWrapping="Wrap" IsVisible="{Binding !IsServiceRunning}" />
          <RadioButton GroupName="killSwitch" IsChecked="{Binding IsKillSwitchOff}" IsEnabled="{Binding IsServiceRunning}"
                       Content="{x:Static res:Strings.KillSwitchOff}" />
          <RadioButton GroupName="killSwitch" IsChecked="{Binding IsKillSwitchWhileConnected}" IsEnabled="{Binding IsServiceRunning}"
                       Content="{x:Static res:Strings.KillSwitchWhileConnected}" />
          <TextBlock Text="{x:Static res:Strings.KillSwitchWhileConnectedHint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <RadioButton GroupName="killSwitch" IsChecked="{Binding IsKillSwitchAlways}" IsEnabled="{Binding CanSelectKillSwitchAlways}"
                       Content="{x:Static res:Strings.KillSwitchAlways}" />
          <TextBlock Text="{x:Static res:Strings.KillSwitchAlwaysHint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <CheckBox IsChecked="{Binding KillSwitchAllowLan}" IsEnabled="{Binding IsServiceRunning}" Content="{x:Static res:Strings.KillSwitchAllowLan}" />
          <TextBlock Text="{Binding KillSwitchError}" Classes="error" TextWrapping="Wrap"
                     IsVisible="{Binding KillSwitchError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <!-- Удалённый DNS (режим TUN и WireGuard): пресет или свой адрес; неверный адрес не сохраняется. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsDnsHeader}" Classes="section" />
          <TextBlock Text="{x:Static res:Strings.SettingsDnsHint}" Classes="muted" TextWrapping="Wrap" />
          <ComboBox ItemsSource="{Binding DnsOptions}" SelectedItem="{Binding SelectedDnsOption}" MinWidth="320" />
          <StackPanel Spacing="6" IsVisible="{Binding IsCustomDns}">
            <TextBox Text="{Binding CustomDnsText}" PlaceholderText="{x:Static res:Strings.DnsCustomPlaceholder}" />
            <TextBlock Text="{Binding CustomDnsError}" Classes="error" TextWrapping="Wrap"
                       IsVisible="{Binding CustomDnsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{x:Static res:Strings.DnsCustomHint}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Маршрутизация (ROADMAP 3.5): пресет, локальная сеть, свои правила сверху вниз. Сохраняется сразу. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsRoutingHeader}" Classes="section" />
          <TextBlock Text="{x:Static res:Strings.SettingsRoutingHint}" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding RoutingNeedsReconnect}">
            <TextBlock Text="{x:Static res:Strings.RoutingReconnectHint}" Classes="warning" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="secondary" Margin="12,0,0,0" Command="{Binding ReconnectCommand}"
                    Content="{x:Static res:Strings.ButtonReconnect}" />
          </Grid>

          <RadioButton GroupName="routingPreset" IsChecked="{Binding IsRoutingAll}" Content="{x:Static res:Strings.RoutingPresetAll}" />
          <TextBlock Text="{x:Static res:Strings.RoutingPresetAllHint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <RadioButton GroupName="routingPreset" IsChecked="{Binding IsRoutingRussia}" Content="{x:Static res:Strings.RoutingPresetRussia}" />
          <TextBlock Text="{x:Static res:Strings.RoutingPresetRussiaHint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <RadioButton GroupName="routingPreset" IsChecked="{Binding IsRoutingApps}" Content="{x:Static res:Strings.RoutingPresetApps}" />
          <TextBlock Text="{x:Static res:Strings.RoutingPresetAppsHint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />
          <CheckBox IsChecked="{Binding RoutingBypassLan}" Content="{x:Static res:Strings.RoutingBypassLan}" />
          <CheckBox IsChecked="{Binding RoutingTunIpv6}" Content="{x:Static res:Strings.RoutingTunIpv6}" />
          <TextBlock Text="{x:Static res:Strings.RoutingTunIpv6Hint}" Classes="caption" TextWrapping="Wrap" Margin="28,-6,0,4" />

          <TextBlock Text="{x:Static res:Strings.RoutingRulesHeader}" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock Text="{x:Static res:Strings.RoutingRulesHint}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static res:Strings.RoutingRulesEmpty}" Classes="muted" IsVisible="{Binding !HasRoutingRules}" />
          <ItemsControl ItemsSource="{Binding RoutingRules}" IsVisible="{Binding HasRoutingRules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RoutingRuleItem">
                <Grid ColumnDefinitions="180,*,130,Auto,Auto,Auto" Margin="0,2">
                  <TextBlock Text="{Binding MatchText}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Rule.Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Rule.Value}" Margin="8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding ActionText}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Classes="icon-button" Width="32" Height="32" IsEnabled="{Binding CanMoveUp}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveRuleUpCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{x:Static res:Strings.RuleMoveUp}" AutomationProperties.Name="{x:Static res:Strings.RuleMoveUp}">
                    <Path Classes="icon small" Data="{StaticResource IconChevronUp}" />
                  </Button>
                  <Button Grid.Column="4" Classes="icon-button" Width="32" Height="32" IsEnabled="{Binding CanMoveDown}"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).MoveRuleDownCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{x:Static res:Strings.RuleMoveDown}" AutomationProperties.Name="{x:Static res:Strings.RuleMoveDown}">
                    <Path Classes="icon small" Data="{StaticResource IconChevronDown}" />
                  </Button>
                  <Button Grid.Column="5" Classes="icon-button" Width="32" Height="32"
                          Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RemoveRuleCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{x:Static res:Strings.RuleRemove}" AutomationProperties.Name="{x:Static res:Strings.RuleRemove}">
                    <Path Classes="icon small" Data="{StaticResource IconClose}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Новое правило: вид, значение (для гео-категорий — подсказки из базы окна), действие. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4,0,0">
            <ComboBox ItemsSource="{Binding RuleMatchOptions}" SelectedItem="{Binding NewRuleMatch}" MinWidth="200" VerticalAlignment="Center" />
            <AutoCompleteBox Grid.Column="1" Margin="8,0" Text="{Binding NewRuleValue}" ItemsSource="{Binding GeoSuggestions}"
                             FilterMode="Contains" MinimumPrefixLength="0" Watermark="{Binding NewRulePlaceholder}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding RuleActionOptions}" SelectedItem="{Binding NewRuleAction}" MinWidth="150" VerticalAlignment="Center" />
            <Button Grid.Column="3" Classes="secondary" Margin="8,0,0,0" Command="{Binding AddRuleCommand}" Content="{x:Static res:Strings.ButtonAddRule}" />
          </Grid>
          <TextBlock Text="{Binding NewRuleError}" Classes="error" TextWrapping="Wrap"
                     IsVisible="{Binding NewRuleError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding NewRuleWarning}" Classes="warning" TextWrapping="Wrap"
                     IsVisible="{Binding NewRuleWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <!-- Гео-базы: файлы окна и копия службы, ручное и автоматическое обновление. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsGeoHeader}" Classes="section" />
          <TextBlock Text="{x:Static res:Strings.SettingsGeoHint}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GeoSiteText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GeoIpText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GeoServiceText}" Classes="caption" TextWrapping="Wrap" />
          <TextBlock Text="{Binding GeoErrorText}" Classes="error" TextWrapping="Wrap"
                     IsVisible="{Binding GeoErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="secondary" Command="{Binding UpdateGeoCommand}" Content="{x:Static res:Strings.ButtonUpdateGeo}" />
            <TextBlock Text="{x:Static res:Strings.GeoUpdating}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsGeoUpdating}" />
          </StackPanel>
          <CheckBox IsChecked="{Binding GeoAutoUpdate}" Content="{x:Static res:Strings.GeoAutoUpdateOption}" />
        </StackPanel>
      </Border>

      <!-- Служба KHORS (режим TUN): состояние, установка и удаление с запросом прав администратора. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsServiceHeader}" Classes="section" />
          <TextBlock Text="{x:Static res:Strings.SettingsServiceHint}" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Ellipse Classes="service-dot" Classes.running="{Binding IsServiceRunning}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding ServiceStateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="secondary" Margin="12,0,0,0" IsVisible="{Binding CanInstallService}"
                    Command="{Binding InstallServiceCommand}" Content="{x:Static res:Strings.ButtonInstallService}"
                    ToolTip.Tip="{x:Static res:Strings.ServiceInstallTooltip}" />
            <Button Grid.Column="3" Classes="secondary" Margin="8,0,0,0" IsVisible="{Binding CanRemoveService}"
                    Command="{Binding RemoveServiceCommand}" Content="{x:Static res:Strings.ButtonDelete}"
                    ToolTip.Tip="{x:Static res:Strings.ServiceRemoveTooltip}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Сброс сетевых настроек KHORS (ROADMAP 4.4): подтверждение со списком действий, затем итог по пунктам. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsResetHeader}" Classes="section" />
          <TextBlock Text="{x:Static res:Strings.SettingsResetHint}" Classes="muted" TextWrapping="Wrap" />
          <Button Classes="secondary" HorizontalAlignment="Left" IsVisible="{Binding !IsResetConfirming}"
                  Command="{Binding AskResetNetworkCommand}" Content="{x:Static res:Strings.ButtonResetNetwork}" />
          <StackPanel Spacing="10" IsVisible="{Binding IsResetConfirming}">
            <TextBlock Text="{x:Static res:Strings.ResetConfirm}" Classes="warning" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="secondary" Command="{Binding ResetNetworkCommand}" Content="{x:Static res:Strings.ButtonResetConfirm}" />
              <Button Classes="secondary" Command="{Binding CancelResetNetworkCommand}" Content="{x:Static res:Strings.ButtonCancel}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{x:Static res:Strings.ResetInProgress}" Classes="muted" IsVisible="{Binding IsResetting}" />
          <SelectableTextBlock Text="{Binding ResetResult}" TextWrapping="Wrap"
                               IsVisible="{Binding ResetResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Static res:Strings.SettingsProfilesHeader}" Classes="section" />
          <CheckBox IsChecked="{Binding SortByLatency}" Content="{x:Static res:Strings.SortByLatency}"
                    ToolTip.Tip="{x:Static res:Strings.SortByLatencyTooltip}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
