<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Khors.App.ViewModels"
        xmlns:res="using:Khors.App.Resources"
        xmlns:profiles="using:Khors.Core.Profiles"
        x:Class="Khors.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.AppTitle}"
        Icon="/Assets/khors.ico"
        Width="420" Height="840"
        MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20">

    <!-- Логотип KHORS (Assets/logo-512.png — тот же, что у KHORS Android). -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
      <Image Source="/Assets/logo-512.png" Width="44" Height="44" RenderOptions.BitmapInterpolationMode="HighQuality" />
      <TextBlock Text="{x:Static res:Strings.AppTitle}" Classes="title" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Статус и кнопка подключения. -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,20,0,0">
      <StackPanel Spacing="10">
        <Button Classes="connect" Classes.connected="{Binding IsConnected}"
                HorizontalAlignment="Center"
                Command="{Binding ToggleConnectionCommand}"
                Content="{Binding ConnectButtonText}" />
        <TextBlock Text="{Binding StatusText}" Classes="status" Classes.failed="{Binding IsFailed}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ActiveProfileName}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding ActiveProfileName, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding StatusDetail}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                   IsVisible="{Binding StatusDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding SessionTime}" Classes="muted" HorizontalAlignment="Center" IsVisible="{Binding IsConnected}" />
        <TextBlock Text="{Binding ConnectionLatency}" Classes="muted" HorizontalAlignment="Center"
                   IsVisible="{Binding ConnectionLatency, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Text="{Binding ModeText}" Classes="muted" HorizontalAlignment="Center" />
        <Expander Header="{x:Static res:Strings.FailureDetails}" IsVisible="{Binding HasLogTail}" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <SelectableTextBlock Text="{Binding LogTail}" Classes="log" TextWrapping="Wrap" />
            <Button Classes="secondary" HorizontalAlignment="Left" Command="{Binding CopyCoreLogCommand}" Content="{x:Static res:Strings.ButtonCopyCoreLog}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <!-- Сообщения: итог импорта, восстановление после сбоя. -->
    <Border DockPanel.Dock="Bottom" Classes="message" IsVisible="{Binding HasMessage}" Margin="0,12,0,0">
      <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>

    <!-- Подписки: трафик, срок, обновление. -->
    <Expander DockPanel.Dock="Top" Margin="0,16,0,0" HorizontalAlignment="Stretch"
              Header="{Binding SubscriptionsHeader}" IsVisible="{Binding HasSubscriptions}" IsExpanded="True">
      <ItemsControl ItemsSource="{Binding Subscriptions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SubscriptionItemViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Details}" Classes="muted small" IsVisible="{Binding HasDetails}" />
                <TextBlock Text="{Binding Status}" Classes="muted small" Classes.error="{Binding HasError}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center" IsEnabled="{Binding !IsUpdating}"
                      Content="{x:Static res:Strings.ButtonUpdate}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UpdateSubscriptionCommand}"
                      CommandParameter="{Binding}" />
              <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center"
                      Content="{x:Static res:Strings.ButtonDelete}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveSubscriptionCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,20,0,8">
      <TextBlock Text="{x:Static res:Strings.ProfilesHeader}" Classes="section" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="secondary" Margin="0,0,8,0" Command="{Binding TestLatencyCommand}"
              Content="{x:Static res:Strings.ButtonTestLatency}" ToolTip.Tip="{x:Static res:Strings.TestLatencyTooltip}" />
      <SplitButton Grid.Column="2" Classes="secondary" Command="{Binding ImportFromClipboardCommand}" Content="{x:Static res:Strings.ButtonImportClipboard}">
        <SplitButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{x:Static res:Strings.MenuImportFile}" Command="{Binding ImportFromFileCommand}" />
            <MenuItem Header="{x:Static res:Strings.MenuImportScreen}" Command="{Binding ImportFromScreenCommand}" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
    </Grid>

    <Panel>
      <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Classes="profiles">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileItemViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{x:Static res:Strings.MenuCopyLink}" Command="{Binding CopyLinkCommand}" />
                  <MenuItem Header="{x:Static res:Strings.MenuShowQr}" Command="{Binding ShowQrCommand}" />
                  <MenuItem Header="{x:Static res:Strings.MenuCore}">
                    <MenuItem Header="{Binding CoreAutoText}" ToggleType="Radio" IsChecked="{Binding IsCoreAuto, Mode=OneWay}"
                              Command="{Binding SetCoreCommand}" CommandParameter="{x:Static profiles:CorePreference.Auto}" />
                    <MenuItem Header="Xray" ToggleType="Radio" IsChecked="{Binding IsCoreXray, Mode=OneWay}"
                              Command="{Binding SetCoreCommand}" CommandParameter="{x:Static profiles:CorePreference.Xray}" />
                    <MenuItem Header="sing-box" ToggleType="Radio" IsChecked="{Binding IsCoreSingBox, Mode=OneWay}"
                              Command="{Binding SetCoreCommand}" CommandParameter="{x:Static profiles:CorePreference.SingBox}" />
                  </MenuItem>
                </ContextMenu>
              </Grid.ContextMenu>
              <Ellipse Width="8" Height="8" Margin="0,0,10,0" Classes="active-marker" IsVisible="{Binding IsActive}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Summary}" Classes="muted small" />
                <TextBlock Text="{Binding Warning}" Classes="warning small" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding LatencyText}" Classes="small latency" VerticalAlignment="Center" Margin="8,0,0,0"
                         ToolTip.Tip="{Binding LatencyTooltip}"
                         Classes.ok="{Binding LatencyOk}" Classes.bad="{Binding LatencyBad}" />
              <Button Grid.Column="3" Classes="ghost" VerticalAlignment="Center"
                      Content="{x:Static res:Strings.ButtonDelete}"
                      Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteProfileCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{x:Static res:Strings.EmptyProfilesHint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                 VerticalAlignment="Center" Margin="24" IsVisible="{Binding HasNoProfiles}" />
    </Panel>
  </DockPanel>
</Window>
