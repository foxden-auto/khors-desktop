<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Khors.App.ViewModels"
        xmlns:res="using:Khors.App.Resources"
        xmlns:pages="using:Khors.App.Views.Pages"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Khors.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static res:Strings.AppTitle}"
        Icon="/Assets/khors.ico"
        Width="1280" Height="860"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="60">
  <!-- Своя шапка: клиентская область заходит под заголовок, системные кнопки окна остаются справа (привязка окон Windows работает). -->
  <DockPanel Margin="{Binding $parent[Window].OffScreenMargin}">

    <Border DockPanel.Dock="Top" Classes="titlebar" chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="20,0,0,0">
        <!-- Логотип KHORS (Assets/logo-512.png — тот же, что у KHORS Android). -->
        <Border Width="36" Height="36" CornerRadius="9" ClipToBounds="True" VerticalAlignment="Center">
          <Image Source="/Assets/logo-512.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="{x:Static res:Strings.AppTitle}" Classes="brand" />
        </StackPanel>
        <!-- Справа — место под системные кнопки «свернуть / развернуть / закрыть». -->
        <Button Grid.Column="3" Classes="icon-button" Margin="0,0,150,0" VerticalAlignment="Center"
                chrome:WindowDecorationProperties.ElementRole="User"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Settings}"
                ToolTip.Tip="{x:Static res:Strings.NavSettings}" AutomationProperties.Name="{x:Static res:Strings.NavSettings}">
          <Path Classes="icon" Data="{StaticResource IconSliders}" />
        </Button>
      </Grid>
    </Border>

    <!-- Боковое меню -->
    <Border DockPanel.Dock="Left" Width="248" BorderBrush="{DynamicResource KhorsBorderBrush}" BorderThickness="0,0,1,0" Padding="14,20">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="message" Background="{DynamicResource KhorsCardBrush}"
                ToolTip.Tip="{Binding ServiceStatusText}">
          <Grid ColumnDefinitions="Auto,*">
            <Ellipse Classes="service-dot" Classes.running="{Binding IsServiceRunning}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{x:Static res:Strings.SettingsServiceHeader}" FontSize="13" />
              <TextBlock Text="{Binding ServiceStateText}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Width="112" Height="112" CornerRadius="28" ClipToBounds="True" Opacity="0.3"
                HorizontalAlignment="Center" Margin="0,0,0,20">
          <Image Source="/Assets/logo-512.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Border>
        <StackPanel Spacing="6">
          <Button Classes="nav" Classes.active="{Binding IsConnectionPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Connection}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Path Classes="icon" Data="{StaticResource IconPower}" />
              <TextBlock Text="{x:Static res:Strings.NavConnection}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsServersPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Servers}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Path Classes="icon" Data="{StaticResource IconServers}" />
              <TextBlock Text="{x:Static res:Strings.NavServers}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Settings}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Path Classes="icon" Data="{StaticResource IconSliders}" />
              <TextBlock Text="{x:Static res:Strings.NavSettings}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsLogPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Log}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Path Classes="icon" Data="{StaticResource IconLog}" />
              <TextBlock Text="{x:Static res:Strings.NavLog}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.active="{Binding IsAboutPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.About}">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Path Classes="icon" Data="{StaticResource IconInfo}" />
              <TextBlock Text="{x:Static res:Strings.NavAbout}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Сообщения: итог импорта, восстановление после сбоя — на любой странице. -->
    <Border DockPanel.Dock="Bottom" Classes="message" IsVisible="{Binding HasMessage}" Margin="20,0,20,20">
      <Grid ColumnDefinitions="*,Auto">
        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="icon-button" Width="32" Height="32" Margin="12,0,0,0" VerticalAlignment="Top"
                Command="{Binding DismissMessageCommand}"
                ToolTip.Tip="{x:Static res:Strings.ButtonClose}" AutomationProperties.Name="{x:Static res:Strings.ButtonClose}">
          <Path Classes="icon small" Data="{StaticResource IconClose}" />
        </Button>
      </Grid>
    </Border>

    <Panel Margin="20">
      <pages:ConnectionPage IsVisible="{Binding IsConnectionPage}" />
      <pages:ServersPage IsVisible="{Binding IsServersPage}" />
      <pages:SettingsPage IsVisible="{Binding IsSettingsPage}" />
      <pages:LogPage IsVisible="{Binding IsLogPage}" />
      <pages:AboutPage IsVisible="{Binding IsAboutPage}" />
    </Panel>
  </DockPanel>
</Window>
