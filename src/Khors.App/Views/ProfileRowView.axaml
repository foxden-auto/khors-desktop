<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Khors.App.ViewModels"
             xmlns:res="using:Khors.App.Resources"
             xmlns:profiles="using:Khors.Core.Profiles"
             x:Class="Khors.App.Views.ProfileRowView"
             x:DataType="vm:ProfileItemViewModel">
  <!-- Строка профиля: код страны, имя и протокол, задержка с полосками сигнала. Действия — в контекстном меню. -->
  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Transparent">
    <Grid.ContextMenu>
      <ContextMenu>
        <MenuItem Header="{x:Static res:Strings.MenuCopyLink}" Command="{Binding CopyLinkCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuShowQr}" Command="{Binding ShowQrCommand}" />
        <MenuItem Header="{x:Static res:Strings.MenuCore}">
          <MenuItem Header="{Binding CoreAutoText}" ToggleType="Radio" IsChecked="{Binding IsCoreAuto, Mode=OneWay}"
                    Command="{Binding SetCoreCommand}" CommandParameter="{x:Static profiles:CorePreference.Auto}" />
          <MenuItem Header="Xray" ToggleType="Radio" IsChecked="{Binding IsCoreXray, Mode=OneWay}"
                    Command="{Binding SetCoreCommand}" CommandParameter="{x:Static profiles:CorePreference.Xray}" />
          <MenuItem Header="sing-box" ToggleType="Radio" IsChecked="{Binding IsCoreSingBox, Mode=OneWay}"
                    Command="{Binding SetCoreCommand}" CommandParameter="{x:Static profiles:CorePreference.SingBox}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static res:Strings.ButtonDelete}" Command="{Binding DeleteCommand}" />
      </ContextMenu>
    </Grid.ContextMenu>

    <Border Classes="badge" VerticalAlignment="Center" Margin="0,0,12,0">
      <Panel>
        <TextBlock Text="{Binding CountryCode}" IsVisible="{Binding HasCountryCode}" />
        <Path Classes="icon" Data="{StaticResource IconGlobe}" IsVisible="{Binding !HasCountryCode}"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>

    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
      <TextBlock Text="{Binding DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Summary}" Classes="caption" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding Warning}" Classes="warning small" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />
    </StackPanel>

    <TextBlock Grid.Column="2" Text="{Binding LatencyText}" Classes="latency" VerticalAlignment="Center" Margin="10,0,0,0"
               Classes.good="{Binding IsLatencyGood}" Classes.mid="{Binding IsLatencyMid}"
               Classes.slow="{Binding IsLatencySlow}" Classes.failed="{Binding LatencyBad}"
               ToolTip.Tip="{Binding LatencyTooltip}" />

    <StackPanel Grid.Column="3" Classes="bars" Orientation="Horizontal" Spacing="2" Height="14" Margin="10,0,0,0"
                VerticalAlignment="Center" IsVisible="{Binding HasLatencyBars}"
                Classes.good="{Binding IsLatencyGood}" Classes.mid="{Binding IsLatencyMid}" Classes.slow="{Binding IsLatencySlow}">
      <Border Classes="b1" Height="6" />
      <Border Classes="b2" Height="10" />
      <Border Classes="b3" Height="14" />
    </StackPanel>

    <Ellipse Grid.Column="4" Classes="active-marker" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsActive}" />
  </Grid>
</UserControl>
